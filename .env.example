# ============================================================================
# Vigyanics — required environment variables
# Copy this file to .env locally, or set these values in Railway > Service >
# Variables. Keep the SERVICE_ROLE_KEY secret — never expose it to the browser.
# ============================================================================

# --- Port (Railway injects PORT automatically; leave blank for Railway) -----
# PORT=8080

# --- Supabase (from app.supabase.com → Project Settings → API) --------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Auth -------------------------------------------------------------------
# Secret used to sign admin JWT tokens. Put a long random string here.
JWT_SECRET=change-me-to-a-long-random-secret

# --- Optional: admin credentials to auto-bootstrap on first deploy ----------
# DEV_ADMIN_EMAIL=admin@vigyanics.com
# DEV_ADMIN_PASSWORD=StrongPassword123!

# --- Optional: API internal port (only needed if tuning) --------------------
# API_INTERNAL_PORT=4000

# --- Optional: admin sub-path (defaults to /admin/) -------------------------
# ADMIN_PATH=/admin/
